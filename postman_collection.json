        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const res = pm.response.json();",
                  "  const token = res.data && (res.data.token || (res.data.tokens && res.data.tokens.access)) || res.token;",
                  "  if (token) pm.collectionVariables.set('ADMIN_TOKEN', token);",
                  "} catch (e) { console.log('no token in response'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nidan.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/admin/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "admin", "login"]
            }
          }
        },
